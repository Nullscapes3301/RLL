(func "inside" (list "_Value" "_List" )
{
    (set "tmp" 0)
    (for "i" _List
        (if (== i _Value)
            (set "tmp" 1)
            (pass)
        )
    )
    (return tmp)
}
)

(import "range")

(func "where" (list "_what" "_list")
{
    (set "ret" 0)

    (for "elem" (range (len _list))
    {
        (if (== (getelem elem _list) _what)
            {
                (set "ret" elem)
            }
            (pass)
        )
    })

    (return ret)
})

(func "unique" (list "_list ")
{
    (set "ret" (list) )
    (set "elems")
    (for "elem" _list
    {
        (if 
            (inside elem elems)
            (pass)
            (append elem ret)
        )
    })
    (return ret)
})

(func "reverse" ["_list"]
{
    (set "ret"  [])
    (set "temp" [])
    (for "relem" _list
    {
        (set "temp" [relem])
        (for "item" ret
        {
            (append item temp)
        })
        (set "ret" temp)
    })
    (return ret)
})